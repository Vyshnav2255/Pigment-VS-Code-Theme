{
  "name": "pitch-black-theme",
  "displayName": "Pitch Black",
  "description": "A true-black dark theme for VS Code with file and UI icon themes from Hugeicons, Phosphor, Lucide, Tabler, Iconoir, Fluent and Heroicons.",
  "version": "1.8.0",
  "publisher": "vyshnav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vyshnav2255/vs-code-themes.git"
  },
  "homepage": "https://github.com/Vyshnav2255/vs-code-themes#readme",
  "bugs": {
    "url": "https://github.com/Vyshnav2255/vs-code-themes/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "black",
    "amoled",
    "oled",
    "icons",
    "hugeicons",
    "product icons",
    "phosphor",
    "lucide",
    "tabler",
    "iconoir",
    "fluent",
    "heroicons"
  ],
  "scripts": {
    "build": "node src/build.mjs && node src/icons.mjs && node src/phosphor.mjs && node src/lucide.mjs && python3 src/font.py && for s in outline filled; do python3 src/font.py producticons-phosphor-$s icons.woff \"Phosphor $s UI\"; done && python3 src/font.py producticons-lucide icons.woff \"Lucide UI\" && node src/packs.mjs && python3 src/font.py producticons-tabler-outline icons.woff \"tabler-outline UI\" && python3 src/font.py producticons-tabler-filled icons.woff \"tabler-filled UI\" && python3 src/font.py producticons-iconoir-regular icons.woff \"iconoir-regular UI\" && python3 src/font.py producticons-iconoir-solid icons.woff \"iconoir-solid UI\" && python3 src/font.py producticons-fluent-regular icons.woff \"fluent-regular UI\" && python3 src/font.py producticons-fluent-filled icons.woff \"fluent-filled UI\" && python3 src/font.py producticons-heroicons-outline icons.woff \"heroicons-outline UI\" && python3 src/font.py producticons-heroicons-solid icons.woff \"heroicons-solid UI\" && node src/aliases.mjs"
  },
  "contributes": {
    "themes": [
      {
        "label": "Pitch Black",
        "uiTheme": "vs-dark",
        "path": "./themes/pitch-black.json"
      },
      {
        "label": "Pitch Black Borderless",
        "uiTheme": "vs-dark",
        "path": "./themes/pitch-black-borderless.json"
      }
    ],
    "iconThemes": [
      {
        "id": "pitch-black-hugeicons",
        "label": "Pitch Black Hugeicons",
        "path": "./fileicons/pitch-black-icons.json"
      },
      {
        "id": "pitch-black-phosphor-outline",
        "label": "Pitch Black Phosphor Outline",
        "path": "./fileicons-phosphor-outline/icons.json"
      },
      {
        "id": "pitch-black-phosphor-filled",
        "label": "Pitch Black Phosphor Filled",
        "path": "./fileicons-phosphor-filled/icons.json"
      },
      {
        "id": "pitch-black-lucide",
        "label": "Pitch Black Lucide",
        "path": "./fileicons-lucide/icons.json"
      },
      {
        "id": "pitch-black-tabler-outline",
        "label": "Pitch Black Tabler Outline",
        "path": "./fileicons-tabler-outline/icons.json"
      },
      {
        "id": "pitch-black-tabler-filled",
        "label": "Pitch Black Tabler Filled",
        "path": "./fileicons-tabler-filled/icons.json"
      },
      {
        "id": "pitch-black-iconoir-regular",
        "label": "Pitch Black Iconoir Regular",
        "path": "./fileicons-iconoir-regular/icons.json"
      },
      {
        "id": "pitch-black-iconoir-solid",
        "label": "Pitch Black Iconoir Solid",
        "path": "./fileicons-iconoir-solid/icons.json"
      },
      {
        "id": "pitch-black-fluent-regular",
        "label": "Pitch Black Fluent Regular",
        "path": "./fileicons-fluent-regular/icons.json"
      },
      {
        "id": "pitch-black-fluent-filled",
        "label": "Pitch Black Fluent Filled",
        "path": "./fileicons-fluent-filled/icons.json"
      },
      {
        "id": "pitch-black-heroicons-outline",
        "label": "Pitch Black Heroicons Outline",
        "path": "./fileicons-heroicons-outline/icons.json"
      },
      {
        "id": "pitch-black-heroicons-solid",
        "label": "Pitch Black Heroicons Solid",
        "path": "./fileicons-heroicons-solid/icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "pitch-black-hugeicons-ui",
        "label": "Pitch Black Hugeicons UI",
        "path": "./producticons/hugeicons-ui.json"
      },
      {
        "id": "pitch-black-phosphor-outline-ui",
        "label": "Pitch Black Phosphor Outline UI",
        "path": "./producticons-phosphor-outline/icons.json"
      },
      {
        "id": "pitch-black-phosphor-filled-ui",
        "label": "Pitch Black Phosphor Filled UI",
        "path": "./producticons-phosphor-filled/icons.json"
      },
      {
        "id": "pitch-black-lucide-ui",
        "label": "Pitch Black Lucide UI",
        "path": "./producticons-lucide/icons.json"
      },
      {
        "id": "pitch-black-tabler-outline-ui",
        "label": "Pitch Black Tabler Outline UI",
        "path": "./producticons-tabler-outline/icons.json"
      },
      {
        "id": "pitch-black-tabler-filled-ui",
        "label": "Pitch Black Tabler Filled UI",
        "path": "./producticons-tabler-filled/icons.json"
      },
      {
        "id": "pitch-black-iconoir-regular-ui",
        "label": "Pitch Black Iconoir Regular UI",
        "path": "./producticons-iconoir-regular/icons.json"
      },
      {
        "id": "pitch-black-iconoir-solid-ui",
        "label": "Pitch Black Iconoir Solid UI",
        "path": "./producticons-iconoir-solid/icons.json"
      },
      {
        "id": "pitch-black-fluent-regular-ui",
        "label": "Pitch Black Fluent Regular UI",
        "path": "./producticons-fluent-regular/icons.json"
      },
      {
        "id": "pitch-black-fluent-filled-ui",
        "label": "Pitch Black Fluent Filled UI",
        "path": "./producticons-fluent-filled/icons.json"
      },
      {
        "id": "pitch-black-heroicons-outline-ui",
        "label": "Pitch Black Heroicons Outline UI",
        "path": "./producticons-heroicons-outline/icons.json"
      },
      {
        "id": "pitch-black-heroicons-solid-ui",
        "label": "Pitch Black Heroicons Solid UI",
        "path": "./producticons-heroicons-solid/icons.json"
      }
    ],
    "configuration": {
      "title": "Pitch Black",
      "properties": {
        "pitchBlack.syncInterfaceIcons": {
          "type": "boolean",
          "default": true,
          "description": "When you pick a Pitch Black file icon theme, also switch the interface (product) icons to the matching Pitch Black UI theme."
        }
      }
    }
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.345",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.50.0",
    "heroicons": "^2.2.0",
    "iconoir": "^7.12.2",
    "lucide-static": "^1.70.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ]
}
