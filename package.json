{
  "name": "pigment-theme",
  "displayName": "Pigment",
  "description": "A collection of VS Code themes named after artist pigments. Starts with Lampblack: true black, vibrant syntax, and 12 icon libraries for files and the interface.",
  "version": "2.0.0",
  "publisher": "vyshnav",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vyshnav2255/Pigment-VS-Code-Theme.git"
  },
  "homepage": "https://github.com/Vyshnav2255/Pigment-VS-Code-Theme#readme",
  "bugs": {
    "url": "https://github.com/Vyshnav2255/Pigment-VS-Code-Theme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "black",
    "amoled",
    "oled",
    "pigment",
    "lampblack",
    "icons",
    "product icons",
    "hugeicons",
    "phosphor",
    "lucide",
    "tabler",
    "iconoir",
    "fluent",
    "heroicons"
  ],
  "scripts": {
    "build": "node src/build.mjs && node src/icons.mjs && node src/phosphor.mjs && node src/lucide.mjs && python3 src/font.py && for s in outline filled; do python3 src/font.py producticons-phosphor-$s icons.woff \"Phosphor $s UI\"; done && python3 src/font.py producticons-lucide icons.woff \"Lucide UI\" && node src/packs.mjs && python3 src/font.py producticons-tabler-outline icons.woff \"tabler-outline UI\" && python3 src/font.py producticons-tabler-filled icons.woff \"tabler-filled UI\" && python3 src/font.py producticons-iconoir-regular icons.woff \"iconoir-regular UI\" && python3 src/font.py producticons-iconoir-solid icons.woff \"iconoir-solid UI\" && python3 src/font.py producticons-fluent-regular icons.woff \"fluent-regular UI\" && python3 src/font.py producticons-fluent-filled icons.woff \"fluent-filled UI\" && python3 src/font.py producticons-heroicons-outline icons.woff \"heroicons-outline UI\" && python3 src/font.py producticons-heroicons-solid icons.woff \"heroicons-solid UI\" && node src/aliases.mjs"
  },
  "contributes": {
    "themes": [
      {
        "label": "Pigment Lampblack",
        "uiTheme": "vs-dark",
        "path": "./themes/lampblack.json"
      },
      {
        "label": "Pigment Lampblack Borderless",
        "uiTheme": "vs-dark",
        "path": "./themes/lampblack-borderless.json"
      }
    ],
    "iconThemes": [
      {
        "id": "pigment-hugeicons",
        "label": "Pigment Hugeicons",
        "path": "./fileicons/icons.json"
      },
      {
        "id": "pigment-phosphor-outline",
        "label": "Pigment Phosphor Outline",
        "path": "./fileicons-phosphor-outline/icons.json"
      },
      {
        "id": "pigment-phosphor-filled",
        "label": "Pigment Phosphor Filled",
        "path": "./fileicons-phosphor-filled/icons.json"
      },
      {
        "id": "pigment-lucide",
        "label": "Pigment Lucide",
        "path": "./fileicons-lucide/icons.json"
      },
      {
        "id": "pigment-tabler-outline",
        "label": "Pigment Tabler Outline",
        "path": "./fileicons-tabler-outline/icons.json"
      },
      {
        "id": "pigment-tabler-filled",
        "label": "Pigment Tabler Filled",
        "path": "./fileicons-tabler-filled/icons.json"
      },
      {
        "id": "pigment-iconoir-regular",
        "label": "Pigment Iconoir Regular",
        "path": "./fileicons-iconoir-regular/icons.json"
      },
      {
        "id": "pigment-iconoir-solid",
        "label": "Pigment Iconoir Solid",
        "path": "./fileicons-iconoir-solid/icons.json"
      },
      {
        "id": "pigment-fluent-regular",
        "label": "Pigment Fluent Regular",
        "path": "./fileicons-fluent-regular/icons.json"
      },
      {
        "id": "pigment-fluent-filled",
        "label": "Pigment Fluent Filled",
        "path": "./fileicons-fluent-filled/icons.json"
      },
      {
        "id": "pigment-heroicons-outline",
        "label": "Pigment Heroicons Outline",
        "path": "./fileicons-heroicons-outline/icons.json"
      },
      {
        "id": "pigment-heroicons-solid",
        "label": "Pigment Heroicons Solid",
        "path": "./fileicons-heroicons-solid/icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "pigment-hugeicons-ui",
        "label": "Pigment Hugeicons UI",
        "path": "./producticons/hugeicons-ui.json"
      },
      {
        "id": "pigment-phosphor-outline-ui",
        "label": "Pigment Phosphor Outline UI",
        "path": "./producticons-phosphor-outline/icons.json"
      },
      {
        "id": "pigment-phosphor-filled-ui",
        "label": "Pigment Phosphor Filled UI",
        "path": "./producticons-phosphor-filled/icons.json"
      },
      {
        "id": "pigment-lucide-ui",
        "label": "Pigment Lucide UI",
        "path": "./producticons-lucide/icons.json"
      },
      {
        "id": "pigment-tabler-outline-ui",
        "label": "Pigment Tabler Outline UI",
        "path": "./producticons-tabler-outline/icons.json"
      },
      {
        "id": "pigment-tabler-filled-ui",
        "label": "Pigment Tabler Filled UI",
        "path": "./producticons-tabler-filled/icons.json"
      },
      {
        "id": "pigment-iconoir-regular-ui",
        "label": "Pigment Iconoir Regular UI",
        "path": "./producticons-iconoir-regular/icons.json"
      },
      {
        "id": "pigment-iconoir-solid-ui",
        "label": "Pigment Iconoir Solid UI",
        "path": "./producticons-iconoir-solid/icons.json"
      },
      {
        "id": "pigment-fluent-regular-ui",
        "label": "Pigment Fluent Regular UI",
        "path": "./producticons-fluent-regular/icons.json"
      },
      {
        "id": "pigment-fluent-filled-ui",
        "label": "Pigment Fluent Filled UI",
        "path": "./producticons-fluent-filled/icons.json"
      },
      {
        "id": "pigment-heroicons-outline-ui",
        "label": "Pigment Heroicons Outline UI",
        "path": "./producticons-heroicons-outline/icons.json"
      },
      {
        "id": "pigment-heroicons-solid-ui",
        "label": "Pigment Heroicons Solid UI",
        "path": "./producticons-heroicons-solid/icons.json"
      }
    ],
    "configuration": {
      "title": "Pigment",
      "properties": {
        "pigment.syncInterfaceIcons": {
          "type": "boolean",
          "default": true,
          "description": "When you pick a Pigment file icon theme, also switch the interface (product) icons to the matching Pigment UI theme."
        },
        "pitchBlack.syncInterfaceIcons": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Renamed to pigment.syncInterfaceIcons.",
          "markdownDeprecationMessage": "Renamed to `#pigment.syncInterfaceIcons#`."
        }
      }
    }
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.345",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.50.0",
    "heroicons": "^2.2.0",
    "iconoir": "^7.12.2",
    "lucide-static": "^1.70.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ]
}
